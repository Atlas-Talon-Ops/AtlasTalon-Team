<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IRONCLAD · Intelligence Retrieval & Analysis</title>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet" />
    <style>
        /* ===== RESET ===== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            background: #050505;
            height: 100%;
            overflow: hidden;
            font-family: 'IBM Plex Mono', monospace;
        }
        #root {
            height: 100%;
        }
        button {
            font-family: inherit;
            cursor: pointer;
        }
        input, textarea, select {
            font-family: inherit;
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: #1a1a1a; }
        ::-webkit-scrollbar-thumb:hover { background: #2a2a2a; }

        /* ===== GRID OVERLAY ===== */
        .ir-grid {
            position: fixed;
            inset: 0;
            background:
                linear-gradient(90deg, transparent 49.5%, rgba(255,255,255,0.015) 50%, transparent 50.5%),
                linear-gradient(0deg, transparent 49.5%, rgba(255,255,255,0.015) 50%, transparent 50.5%);
            background-size: 48px 48px;
            pointer-events: none;
            z-index: 0;
        }
        .ir-vignette {
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at 50% 0%, transparent 0%, rgba(0,0,0,0.4) 50%, #000000 100%);
            pointer-events: none;
            z-index: 1;
        }
        .ir-scan {
            position: fixed;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
            animation: scanMove 12s linear infinite;
            pointer-events: none;
            z-index: 2;
        }
        @keyframes scanMove {
            0% { top: 0; opacity: 0; }
            5% { opacity: 1; }
            95% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        /* ===== APP CONTAINER ===== */
        .ir-app {
            position: relative;
            z-index: 10;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: transparent;
            color: #e0e0e0;
        }

        /* ===== TOP BAR ===== */
        .ir-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 24px;
            border-bottom: 1px solid #1a1a1a;
            background: rgba(5, 5, 5, 0.95);
            backdrop-filter: blur(8px);
            flex-shrink: 0;
            z-index: 20;
        }
        .ir-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .ir-logo {
            width: 34px;
            height: 34px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: rgba(255, 255, 255, 0.04);
        }
        .ir-logo::before {
            content: '';
            position: absolute;
            inset: 3px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .ir-logo::after {
            content: '';
            position: absolute;
            top: -3px;
            right: -3px;
            width: 5px;
            height: 5px;
            background: #ffffff;
            box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .ir-logo-text {
            font-family: 'Orbitron', monospace;
            font-size: 14px;
            color: #ffffff;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .ir-brand-title {
            font-family: 'Orbitron', monospace;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 3px;
            color: #e0e0e0;
        }
        .ir-brand-sub {
            font-size: 8px;
            color: #555;
            letter-spacing: 2px;
            margin-top: 1px;
        }
        .ir-status {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 9px;
            letter-spacing: 2px;
            color: #555;
        }
        .ir-status-pill {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border: 1px solid #1a1a1a;
            background: #0a0a0a;
        }
        .ir-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #34C759;
            box-shadow: 0 0 6px #34C759;
        }
        .ir-dot.warn { background: #FFD60A; box-shadow: 0 0 6px #FFD60A; }
        .ir-dot.danger { background: #FF3D00; box-shadow: 0 0 6px #FF3D00; }
        .ir-dot.white { background: #ffffff; box-shadow: 0 0 6px rgba(255,255,255,0.3); }
        .ir-clock {
            font-size: 10px;
            color: #888;
            letter-spacing: 2px;
        }
        .ir-btn-primary {
            background: #ffffff;
            border: 1px solid #ffffff;
            color: #000;
            font-weight: 700;
            padding: 6px 16px;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.2s;
        }
        .ir-btn-primary:hover {
            background: #e6e6e6;
            box-shadow: 0 0 0 1px #ffffff, 0 0 24px rgba(255,255,255,0.1);
        }

        /* ===== MAIN LAYOUT ===== */
        .ir-main {
            flex: 1;
            display: flex;
            overflow: hidden;
            position: relative;
            z-index: 10;
        }

        /* ===== SEARCH PANEL ===== */
        .ir-search-panel {
            width: 400px;
            min-width: 400px;
            border-right: 1px solid #1a1a1a;
            display: flex;
            flex-direction: column;
            background: rgba(5, 5, 5, 0.9);
            padding: 16px 20px;
            overflow-y: auto;
            flex-shrink: 0;
        }
        .ir-search-panel::-webkit-scrollbar { width: 4px; }
        .ir-search-panel::-webkit-scrollbar-thumb { background: #1a1a1a; }

        .ir-search-header {
            font-size: 9px;
            color: #555;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .ir-search-header::before {
            content: '';
            width: 3px;
            height: 12px;
            background: #ffffff;
        }

        .ir-search-input-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-bottom: 12px;
        }
        .ir-search-input-group label {
            font-size: 8px;
            color: #444;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .ir-search-input {
            width: 100%;
            background: #0a0a0a;
            border: 1px solid #1a1a1a;
            padding: 8px 12px;
            font-size: 11px;
            color: #c0c0c0;
            outline: none;
            transition: border-color 0.2s;
        }
        .ir-search-input:focus {
            border-color: #ffffff;
        }
        .ir-search-input::placeholder {
            color: #333;
        }
        .ir-search-textarea {
            width: 100%;
            background: #0a0a0a;
            border: 1px solid #1a1a1a;
            padding: 8px 12px;
            font-size: 10px;
            color: #c0c0c0;
            outline: none;
            resize: vertical;
            min-height: 50px;
            transition: border-color 0.2s;
            line-height: 1.6;
        }
        .ir-search-textarea:focus {
            border-color: #ffffff;
        }
        .ir-search-textarea::placeholder {
            color: #333;
        }

        .ir-search-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }
        .ir-option-group {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .ir-option-group label {
            font-size: 7px;
            color: #444;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .ir-select {
            background: #0a0a0a;
            border: 1px solid #1a1a1a;
            padding: 6px 8px;
            font-size: 9px;
            color: #c0c0c0;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s;
        }
        .ir-select:focus {
            border-color: #ffffff;
        }

        .ir-search-btn {
            width: 100%;
            padding: 12px;
            background: #ffffff;
            border: 1px solid #ffffff;
            color: #000;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: all 0.2s;
            margin-top: 6px;
        }
        .ir-search-btn:hover {
            background: #e6e6e6;
            box-shadow: 0 0 0 1px #ffffff, 0 0 24px rgba(255,255,255,0.1);
        }
        .ir-search-btn:disabled {
            background: #0a0a0a;
            color: #444;
            border-color: #1a1a1a;
            cursor: not-allowed;
        }
        .ir-search-btn:disabled:hover {
            box-shadow: none;
        }

        .ir-search-status {
            font-size: 8px;
            color: #444;
            letter-spacing: 2px;
            text-align: center;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid #1a1a1a;
        }
        .ir-search-status .active {
            color: #34C759;
        }
        .ir-search-status .error {
            color: #FF3D00;
        }
        .ir-progress-bar {
            width: 100%;
            height: 2px;
            background: #1a1a1a;
            margin-top: 6px;
            overflow: hidden;
        }
        .ir-progress-fill {
            height: 100%;
            background: #ffffff;
            width: 0%;
            transition: width 0.3s;
            box-shadow: 0 0 8px rgba(255,255,255,0.3);
        }

        /* ===== RESULTS PANEL ===== */
        .ir-results-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: rgba(5, 5, 5, 0.8);
            overflow: hidden;
        }
        .ir-results-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            border-bottom: 1px solid #1a1a1a;
            flex-shrink: 0;
            background: rgba(5, 5, 5, 0.9);
            flex-wrap: wrap;
            gap: 6px;
        }
        .ir-results-title {
            font-size: 9px;
            color: #555;
            letter-spacing: 3px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .ir-results-title::before {
            content: '';
            width: 3px;
            height: 12px;
            background: #ffffff;
        }
        .ir-results-id {
            font-size: 8px;
            color: #444;
            letter-spacing: 2px;
        }
        .ir-results-id span {
            color: #ffffff;
        }

        /* ===== TABS ===== */
        .ir-tabs {
            display: flex;
            background: rgba(10, 10, 10, 0.9);
            border-bottom: 1px solid #1a1a1a;
            flex-shrink: 0;
            padding: 0 6px;
            overflow-x: auto;
        }
        .ir-tab {
            background: transparent;
            border: none;
            padding: 10px 16px;
            color: #444;
            font-size: 8px;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            text-transform: uppercase;
            white-space: nowrap;
            font-family: 'IBM Plex Mono', monospace;
        }
        .ir-tab:hover {
            color: #888;
        }
        .ir-tab.active {
            color: #ffffff;
        }
        .ir-tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 1px;
            background: #ffffff;
            box-shadow: 0 0 6px rgba(255,255,255,0.3);
        }
        .ir-tab-count {
            font-size: 7px;
            color: #555;
            padding: 1px 5px;
            border: 1px solid #1a1a1a;
            background: #0a0a0a;
            margin-left: 5px;
        }
        .ir-tab.active .ir-tab-count {
            color: #ffffff;
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.05);
        }

        .ir-results-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px 20px;
        }
        .ir-results-body::-webkit-scrollbar { width: 4px; }
        .ir-results-body::-webkit-scrollbar-thumb { background: #1a1a1a; }

        /* ===== DOSSIER CARD ===== */
        .ir-dossier {
            background: #0a0a0a;
            border: 1px solid #1a1a1a;
            border-left: 3px solid #ffffff;
            padding: 18px 20px;
            animation: fadeIn 0.5s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .ir-dossier-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 14px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .ir-dossier-name {
            font-family: 'Orbitron', monospace;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 2px;
        }
        .ir-dossier-id {
            font-size: 9px;
            color: #444;
            letter-spacing: 2px;
            font-family: 'IBM Plex Mono', monospace;
        }
        .ir-dossier-id span {
            color: #ffffff;
        }
        .ir-dossier-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 8px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.04);
        }
        .ir-dossier-badge .ir-dot {
            width: 4px;
            height: 4px;
        }
        .ir-dossier-section {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid #1a1a1a;
        }
        .ir-dossier-section-title {
            font-size: 8px;
            color: #555;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .ir-dossier-section-title::before {
            content: '';
            width: 3px;
            height: 10px;
            background: #ffffff;
        }
        .ir-dossier-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 6px 14px;
        }
        .ir-dossier-item {
            display: flex;
            flex-direction: column;
            gap: 1px;
        }
        .ir-dossier-item-label {
            font-size: 7px;
            color: #444;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .ir-dossier-item-value {
            font-size: 11px;
            color: #c0c0c0;
            word-break: break-word;
        }
        .ir-dossier-item-value .highlight {
            color: #ffffff;
        }
        .ir-dossier-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 6px;
        }
        .ir-dossier-tag {
            padding: 2px 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            font-size: 7px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.5);
        }
        .ir-dossier-actions {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid #1a1a1a;
        }
        .ir-dossier-actions button {
            padding: 6px 14px;
            font-size: 8px;
            letter-spacing: 2px;
            text-transform: uppercase;
            border: 1px solid;
            background: transparent;
            transition: all 0.2s;
        }
        .ir-dossier-actions .ir-add-identity {
            border-color: #ffffff;
            color: #ffffff;
        }
        .ir-dossier-actions .ir-add-identity:hover {
            background: #ffffff;
            color: #000;
            box-shadow: 0 0 16px rgba(255,255,255,0.15);
        }
        .ir-dossier-actions .ir-add-identity.added {
            border-color: #34C759;
            color: #34C759;
        }
        .ir-dossier-actions .ir-add-identity.added:hover {
            background: #34C759;
            color: #000;
        }
        .ir-dossier-actions .ir-export {
            border-color: #1a1a1a;
            color: #666;
        }
        .ir-dossier-actions .ir-export:hover {
            border-color: #555;
            color: #c0c0c0;
        }

        /* ===== TAB CONTENT STYLES ===== */
        .ir-tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .ir-tab-content.active {
            display: block;
        }

        /* ===== MEDIA CARDS ===== */
        .ir-media-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 14px;
        }
        .ir-media-card {
            background: #050505;
            border: 1px solid #1a1a1a;
            overflow: hidden;
            transition: all 0.3s;
            position: relative;
        }
        .ir-media-card:hover {
            border-color: #2a2a2a;
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        .ir-media-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            display: block;
        }
        .ir-media-card .ir-media-info {
            padding: 10px 12px;
        }
        .ir-media-card .ir-media-info .title {
            font-size: 10px;
            color: #c0c0c0;
            letter-spacing: 0.5px;
            font-weight: 500;
            margin-bottom: 4px;
        }
        .ir-media-card .ir-media-info .meta {
            font-size: 8px;
            color: #444;
            letter-spacing: 1px;
            display: flex;
            justify-content: space-between;
        }
        .ir-media-card .ir-media-info .meta .source {
            color: #555;
        }
        .ir-media-card .ir-media-info .meta .date {
            color: #333;
        }
        .ir-media-card .ir-play-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s;
            cursor: pointer;
        }
        .ir-media-card:hover .ir-play-overlay {
            opacity: 1;
        }
        .ir-media-card .ir-play-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            border: 2px solid rgba(255,255,255,0.5);
            color: #ffffff;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }
        .ir-media-card .ir-play-btn:hover {
            background: rgba(255,255,255,0.25);
            border-color: #ffffff;
            transform: scale(1.1);
        }

        /* Video card */
        .ir-video-card {
            background: #050505;
            border: 1px solid #1a1a1a;
            padding: 14px 16px;
            transition: all 0.3s;
            margin-bottom: 10px;
        }
        .ir-video-card:hover {
            border-color: #2a2a2a;
        }
        .ir-video-card .ir-video-title {
            font-size: 12px;
            color: #ffffff;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .ir-video-card .ir-video-title .ir-play-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #888;
            flex-shrink: 0;
            transition: all 0.3s;
        }
        .ir-video-card:hover .ir-video-title .ir-play-icon {
            border-color: #ffffff;
            color: #ffffff;
            background: rgba(255,255,255,0.05);
        }
        .ir-video-card .ir-video-meta {
            font-size: 8px;
            color: #444;
            letter-spacing: 1px;
            margin-top: 6px;
            display: flex;
            gap: 14px;
        }
        .ir-video-card .ir-video-meta span {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .ir-video-card .ir-video-url {
            font-size: 8px;
            color: #333;
            margin-top: 6px;
            word-break: break-all;
            font-family: 'IBM Plex Mono', monospace;
        }

        /* ===== NEWS CARDS ===== */
        .ir-news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 14px;
        }
        .ir-news-card {
            background: #050505;
            border: 1px solid #1a1a1a;
            padding: 16px 18px;
            transition: all 0.3s;
            border-left: 2px solid rgba(255,255,255,0.15);
        }
        .ir-news-card:hover {
            border-color: #2a2a2a;
            border-left-color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }
        .ir-news-card .ir-news-headline {
            font-size: 13px;
            color: #ffffff;
            font-weight: 600;
            line-height: 1.4;
            margin-bottom: 6px;
        }
        .ir-news-card .ir-news-snippet {
            font-size: 10px;
            color: #888;
            line-height: 1.6;
            margin-bottom: 10px;
        }
        .ir-news-card .ir-news-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 8px;
            color: #555;
            letter-spacing: 1px;
            padding-top: 10px;
            border-top: 1px solid #1a1a1a;
        }
        .ir-news-card .ir-news-footer .source {
            color: #888;
        }
        .ir-news-card .ir-news-footer .date {
            color: #444;
        }
        .ir-news-card .ir-news-footer .ir-news-link {
            color: #333;
            text-decoration: none;
            transition: color 0.2s;
