            };
        }

        // ==================== TOAST HOOK ====================
        function useToasts() {
            const [toasts, setToasts] = useState([]);
            const idRef = useRef(0);

            const push = useCallback((type, title, msg, duration = 3500) => {
                const id = ++idRef.current;
                setToasts(prev => [...prev, { id, type, title, msg }]);
                setTimeout(() => {
                    setToasts(prev => prev.map(t => t.id === id ? { ...t, out: true } : t));
                    setTimeout(() => {
                        setToasts(prev => prev.filter(t => t.id !== id));
                    }, 250);
                }, duration);
            }, []);

            return { toasts, push };
        }

        // ==================== IDENTITY VAULT ====================
        function useIdentityVault() {
            const [identities, setIdentities] = useState([]);

            useEffect(() => {
                const stored = localStorage.getItem('ironclad_identities');
                if (stored) {
                    try {
                        setIdentities(JSON.parse(stored));
                    } catch (_) {
                        setIdentities([]);
                    }
                }
            }, []);

            useEffect(() => {
                localStorage.setItem('ironclad_identities', JSON.stringify(identities));
            }, [identities]);

            const addIdentity = useCallback((dossier) => {
                const identity = {
                    id: 'ID-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(Math.random() * 9000 + 1000),
                    name: dossier.name,
                    type: dossier.type,
                    classification: dossier.classification,
                    agency: dossier.agency,
                    codename: dossier.codename,
                    location: dossier.details.location,
                    status: dossier.details.status,
                    tags: dossier.tags,
                    dossier_id: dossier.id,
                    added: new Date().toISOString(),
                    data: dossier
                };
                setIdentities(prev => [identity, ...prev]);
                return identity;
            }, []);

            const removeIdentity = useCallback((id) => {
                setIdentities(prev => prev.filter(i => i.id !== id));
            }, []);

            return { identities, addIdentity, removeIdentity };
        }

