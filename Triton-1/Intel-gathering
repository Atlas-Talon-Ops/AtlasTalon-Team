                                                                        <span className="source">{item.source}</span>
                                                                        <span className="date">{item.date}</span>
                                                                        <a href="#" className="ir-news-link">Read →</a>
                                                                    </div>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    ) : (
                                                        <p style={{ color: '#444', fontSize: '10px', padding: '12px 0' }}>No news articles found.</p>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    </>
                                ) : (
                                    <div className="ir-empty-results">
                                        <div className="ir-empty-icon">⎔</div>
                                        <div className="ir-empty-title">NO DOSSIER LOADED</div>
                                        <div className="ir-empty-sub">Enter query parameters and initiate retrieval</div>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>

                    {/* Vault Toggle Button */}
                    <button className="ir-vault-toggle" onClick={() => setShowVault(true)}>
                        IDENTITY VAULT · <span className="count">{identities.length}</span>
                    </button>

                    {/* Vault Modal */}
                    <div className={`ir-modal-overlay ${showVault ? 'open' : ''}`} onClick={e => { if (e.target === e.currentTarget) setShowVault(false); }}>
                        <div className="ir-modal">
                            <div className="ir-modal-corner tl" />
                            <div className="ir-modal-corner tr" />
                            <div className="ir-modal-corner bl" />
                            <div className="ir-modal-corner br" />
                            <div className="ir-modal-header">
                                <span className="ir-modal-title">IDENTITY VAULT · {identities.length} ASSETS</span>
                                <button className="ir-modal-close" onClick={() => setShowVault(false)}>×</button>
                            </div>
                            <div className="ir-modal-body">
                                {identities.length === 0 ? (
                                    <div className="ir-empty-vault">
                                        <div style={{ fontSize: '28px', marginBottom: '10px' }}>◈</div>
                                        <div>NO IDENTITIES ARCHIVED</div>
                                        <div style={{ fontSize: '8px', color: '#333', marginTop: '4px' }}>
                                            Retrieve intelligence and add to vault
                                        </div>
                                    </div>
                                ) : (
                                    <div className="ir-identity-grid">
                                        {identities.map(id => (
                                            <div key={id.id} className="ir-identity-card">
                                                <div className="ir-identity-name">{id.name}</div>
                                                <div className="ir-identity-meta">
                                                    {id.type} · <span>{id.classification}</span> · {id.codename}
                                                </div>
                                                <div className="ir-identity-meta" style={{ fontSize: '7px' }}>
                                                    {id.location} · {id.status}
                                                </div>
                                                <div className="ir-identity-tags">
                                                    {(id.tags || []).slice(0, 4).map((t, i) => (
                                                        <span key={i} className="ir-identity-tag">{t}</span>
                                                    ))}
                                                </div>
                                                <div className="ir-identity-actions">
                                                    <button onClick={() => { /* View dossier */ }}>VIEW</button>
                                                    <button className="ir-id-del" onClick={() => removeIdentity(id.id)}>PURGE</button>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>

                    {/* Toasts */}
                    <div className="ir-toast-wrap">
                        {toasts.map(t => (
                            <div key={t.id} className={`ir-toast ${t.type} ${t.out ? 'out' : ''}`}>
                                <div className="ir-toast-title">{t.title}</div>
                                <div className="ir-toast-msg">{t.msg}</div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // Mount
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
