<body>
    <div id="root"></div>

    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <script type="text/babel">
        const { useState, useEffect, useRef, useCallback } = React;

        // ==================== CONSTANTS ====================
        const AGENCY_CODENAMES = [
            'IRONCLAD', 'GHOST-9', 'BLACKSTONE', 'ECHO-7', 'NIGHTFALL',
            'SHADOW-3', 'PHANTOM', 'CERBERUS', 'WATCHDOG', 'VALKYRIE'
        ];

        const SOCIAL_PLATFORMS = ['Twitter', 'LinkedIn', 'Facebook', 'Instagram', 'GitHub', 'Telegram', 'Signal'];

        // ==================== MOCK SEARCH ENGINE ====================
        function mockIntelligenceSearch(query, type, depth, socialHandle) {
            return new Promise((resolve) => {
                const delay = 800 + (depth === 'deep' ? 1400 : depth === 'standard' ? 700 : 400);
                const extraDelay = Math.random() * 500;

                setTimeout(() => {
                    const results = generateMockDossier(query, type, depth, socialHandle);
                    resolve(results);
                }, delay + extraDelay);
            });
        }

        function generateMockDossier(query, type, depth, socialHandle) {
            const id = 'DOS-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(Math.random() * 9000 + 1000);
            const now = new Date().toISOString();

            const names = [
                'Alexander Volkov', 'Mira Chen', 'Jonathan Hayes', 'Elena Vasquez',
                'Marcus Webb', 'Sarah Nakamura', 'David O\'Malley', 'Priya Sharma',
                'James Morrison', 'Anna Kowalski', 'Robert Chen', 'Maria Santos',
                'William Park', 'Lisa Tanaka', 'Michael Schmidt', 'Emma Dubois'
            ];

            const companies = [
                'Apex Dynamics', 'Nexus Technologies', 'Cascade Solutions', 'Ironforge Industries',
                'Quantum Systems', 'Pinnacle Group', 'Vertex Holdings', 'Sigma Defense',
                'Oracle Innovations', 'Phoenix Global', 'Atlas Consolidated', 'Titan Corporation'
            ];

            const locations = [
                'Washington D.C., USA', 'London, UK', 'Berlin, Germany', 'Tokyo, Japan',
                'Singapore', 'Dubai, UAE', 'Sydney, Australia', 'Toronto, Canada',
                'Austin, Texas', 'Seattle, Washington', 'Boston, Massachusetts', 'Denver, Colorado'
            ];

            const agencies = ['DIA', 'CIA', 'NSA', 'FBI', 'MI6', 'BND', 'DGSE', 'Mossad', 'CSIS', 'ASIS'];
            const classifications = ['RESTRICTED', 'CONFIDENTIAL', 'SECRET', 'TOP SECRET', 'BLACK'];

            const tags = [
                'PERSON OF INTEREST', 'ASSET', 'TARGET', 'SUBJECT', 'SOURCE',
                'SURVEILLANCE', 'WIRETAP', 'HUMINT', 'SIGINT', 'GEOLOCATION',
                'FINANCIAL', 'TRAVEL', 'ASSOCIATES', 'COMMUNICATIONS', 'DARKWEB'
            ];

            const targetName = query.trim() || names[Math.floor(Math.random() * names.length)];
            const isCompany = type === 'company' || query.includes('corp') || query.includes('inc') || query.includes('llc');
            const isLocation = type === 'location' || query.includes('city') || query.includes('state') || query.includes(
                'country');
            const name = isCompany ? companies[Math.floor(Math.random() * companies.length)] :
                isLocation ? locations[Math.floor(Math.random() * locations.length)] :
                targetName;

            const classification = classifications[Math.floor(Math.random() * classifications.length)];
            const agency = agencies[Math.floor(Math.random() * agencies.length)];
            const codename = AGENCY_CODENAMES[Math.floor(Math.random() * AGENCY_CODENAMES.length)];

            // Generate social media profiles with posts
            const socialProfiles = [];
            const numProfiles = 2 + Math.floor(Math.random() * 3);
            const shuffledPlatforms = [...SOCIAL_PLATFORMS].sort(() => Math.random() - 0.5);
            for (let i = 0; i < Math.min(numProfiles, shuffledPlatforms.length); i++) {
                const platform = shuffledPlatforms[i];
                const handle = socialHandle && socialHandle.trim() ?
                    socialHandle.trim().replace(/^@/, '') :
                    name.toLowerCase().replace(/\s/g, '') + (Math.random() > 0.5 ? Math.floor(Math.random() * 99) : '');
                const posts = [];
                const postCount = 2 + Math.floor(Math.random() * 3);
                for (let j = 0; j < postCount; j++) {
                    const hasMedia = Math.random() > 0.5;
                    const mediaUrls = hasMedia ? [
                        `https://picsum.photos/seed/${Math.random().toString(36).substring(7)}/400/300`,
                        `https://picsum.photos/seed/${Math.random().toString(36).substring(7)}/400/300`
                    ] : [];
                    posts.push({
                        content: [
                            `Just landed in ${locations[Math.floor(Math.random() * locations.length)]}. #mission #fieldwork`,
                            `Meeting with ${names[Math.floor(Math.random() * names.length)]} later today. #opsec`,
                            `Great progress on the ${companies[Math.floor(Math.random() * companies.length)]} contract. #success #classified`,
                            `Traveling to ${locations[Math.floor(Math.random() * locations.length)]} next week. #prep #covert`,
                            `New project starting. #confidential #needtoknow`,
                            `Happy to announce a new partnership with ${companies[Math.floor(Math.random() * companies.length)]}. #milestone`,
                            `Analysis complete. Sending report to ${agency}. #intel #done`,
                            `Interesting developments in ${locations[Math.floor(Math.random() * locations.length)]}. #monitoring #situationalawareness`
                        ][j % 8],
                        time: new Date(Date.now() - j * 2 * 24 * 60 * 60 * 1000 - Math.random() * 12 * 60 * 60 * 1000)
                            .toISOString(),
                        likes: Math.floor(Math.random() * 2000 + 50),
                        retweets: Math.floor(Math.random() * 500 + 10),
                        replies: Math.floor(Math.random() * 100 + 5),
                        media: mediaUrls
                    });
                }
                socialProfiles.push({
                    platform: platform,
                    handle: '@' + handle,
                    url: `${platform.toLowerCase()}.com/${handle}`,
                    bio: `${platform} profile for ${name}`,
                    followers: Math.floor(Math.random() * 50000 + 100),
                    following: Math.floor(Math.random() * 2000 + 50),
                    posts: posts
                });
            }

            // Generate images
            const images = [];
            const imageTitles = ['Surveillance Photo', 'Meeting Location', 'Asset Identification', 'Document Capture',
                'Event Coverage', 'Person of Interest', 'Location Recon', 'Evidence Photo'
            ];
            for (let i = 0; i < 4 + Math.floor(Math.random() * 4); i++) {
                images.push({
                    url: `https://picsum.photos/seed/${Math.random().toString(36).substring(7)}/400/300`,
                    title: `${imageTitles[i % imageTitles.length]} ${i+1}`,
                    source: ['OSINT', 'SOCIAL', 'SIGINT', 'HUMINT'][Math.floor(Math.random() * 4)],
                    date: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
                });
            }

            // Generate videos
            const videos = [];
            const videoTitles = ['Interview Footage', 'Briefing Recording', 'Press Conference', 'Surveillance Clip',
                'Meeting Recording'
            ];
            for (let i = 0; i < 2 + Math.floor(Math.random() * 3); i++) {
                videos.push({
                    url: `https://www.youtube.com/watch?v=${Math.random().toString(36).substring(2, 13)}`,
                    title: `${videoTitles[i % videoTitles.length]} - ${name}`,
                    source: ['YouTube', 'Vimeo', 'Archive'][Math.floor(Math.random() * 3)],
                    views: Math.floor(Math.random() * 100000 + 1000),
                    date: new Date(Date.now() - Math.random() * 60 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
                });
            }

            // Generate news articles
            const news = [];
            const headlines = [
                `${name} involved in major ${isCompany ? 'corporate merger' : 'development'}`,
                `Exclusive: ${name} linked to recent ${isCompany ? 'financial' : 'security'} investigation`,
                `${name} announces ${isCompany ? 'record profits' : 'new initiative'}`,
                `Sources say ${name} connected to ${isCompany ? 'regulatory probe' : 'intelligence operation'}`,
                `${name} to appear before ${isCompany ? 'Congress' : 'international tribunal'}`,
                `New evidence emerges in ${isCompany ? 'tax evasion' : 'personal conduct'} case involving ${name}`,
                `${name} expands operations into ${locations[Math.floor(Math.random() * locations.length)]}`,
                `Leaked documents reveal ${isCompany ? 'offshore accounts' : 'hidden assets'} tied to ${name}`
            ];
            for (let i = 0; i < 4 + Math.floor(Math.random() * 4); i++) {
                const date = new Date(Date.now() - Math.random() * 90 * 24 * 60 * 60 * 1000);
                news.push({
                    headline: headlines[i % headlines.length],
                    snippet: `Recent reporting indicates ${name} is at the center of a developing story. Sources close to the investigation suggest ${isCompany ? 'financial irregularities' : 'potential connections to multiple agencies'}. The full extent of ${name}'s involvement remains unclear.`,
                    source: ['Reuters', 'Bloomberg', 'BBC', 'CNN', 'The Guardian', 'WSJ', 'Associated Press'][Math.floor(
                        Math.random() * 7)],
                    date: date.toISOString().split('T')[0],
                    url: `https://news.example.com/${name.toLowerCase().replace(/\s/g, '-')}-${i}`
                });
            }

            // Generate associates
            const associateCount = 2 + Math.floor(Math.random() * 4);
            const associates = [];
            for (let i = 0; i < associateCount; i++) {
                const n = names[Math.floor(Math.random() * names.length)];
                if (n !== name) {
                    associates.push({
                        name: n,
                        relation: ['ASSOCIATE', 'CONTACT', 'RELATIVE', 'BUSINESS_PARTNER', 'SUBORDINATE', 'SUPERIOR'][Math
                            .floor(Math.random() * 6)
                        ],
                        confidence: Math.floor(70 + Math.random() * 25) + '%'
                    });
                }
            }

            // Generate timeline
            const timeline = [];
            const nowDate = new Date();
            for (let i = 0; i < 3 + Math.floor(Math.random() * 4); i++) {
                const d = new Date(nowDate);
                d.setMonth(d.getMonth() - i * (1 + Math.floor(Math.random() * 3)));
                timeline.push({
                    date: d.toISOString().split('T')[0],
                    event: ['MEETING', 'TRAVEL', 'COMMUNICATION', 'FINANCIAL_TRANSACTION', 'ASSOCIATE_CONTACT', 'LOCATION_CHANGE'][
                        Math.floor(Math.random() * 6)
                    ],
                    details: `Activity recorded at ${locations[Math.floor(Math.random() * locations.length)]}`
                });
            }

            // Generate financial data
            const financials = [
                { source: 'BANK ACCOUNT', details: `XX-${String(Math.floor(Math.random() * 1000000)).padStart(6, '0')}` },
                { source: 'CRYPTO WALLET', details: `0x${Array.from({length: 20}, () => Math.floor(Math.random() * 16).toString(16)).join('')}` },
                { source: 'OFFSHORE ENTITY', details: `${companies[Math.floor(Math.random() * companies.length)]} LTD` }
            ];

